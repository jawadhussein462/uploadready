# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for deployment.
# Every variable is optional: without them the app still works with the
# built-in rule reader and free downloads.

# --- AI reading of upload instructions (text and screenshots) -------------
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model used to read the rules. Any current Claude model that supports tool use works.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only change this to route requests through a proxy or a local mock.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Payments (Stripe Checkout, one-time payment per packet) --------------
# Use sk_test_… while testing, sk_live_… in production.
STRIPE_SECRET_KEY=
# Price per packet in the smallest currency unit (490 = €4.90) and its currency.
PACKET_PRICE_CENTS=490
PACKET_CURRENCY=eur
# Secret for signing "this packet is paid" receipts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNLOCK_TOKEN_SECRET=
# For local tests against stripe-mock or the mock in e2e/mocks.js.
# STRIPE_API_BASE=http://localhost:12111

# --- Site --------------------------------------------------------------------
# Public URL, used for Stripe redirects, the sitemap and social previews.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Requests per IP per 10 minutes to the AI reader (soft, per server instance).
RATE_LIMIT_PER_10_MIN=20
